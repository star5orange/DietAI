# ========================================
# DietAI 生产环境配置
# ========================================
# 使用方法：
#   1. 修改下面的占位符（替换 YOUR_xxx）
#   2. 在服务器上运行生成密钥的命令获取随机值
# ========================================

# ========================================
# AI 模型 API 密钥
# ========================================
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DIETAI_DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DIETAI_DASHSCOPE_IMAGE_MODEL=wanx-v1

DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ANALYSIS_MODEL_PROVIDER=deepseek
ANALYSIS_MODEL=deepseek-v4-flash

VISION_MODEL_PROVIDER=qwen
VISION_MODEL=qwen-vl-max

# ========================================
# 基础设施配置
# ========================================
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

VECTOR_STORE_PATH=agents/VectorStore
VECTOR_COLLECTION_NAME=nutrition_collection

# ========================================
# AI 服务配置
# ========================================
DIETAI_AI_SERVICE_URL=http://127.0.0.1:2024

# ========================================
# 安全配置（生产环境必填）
# ========================================
DIETAI_DEBUG=false

# JWT - 生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DIETAI_JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
DIETAI_JWT_ALGORITHM=HS256

# 字段加密 - 生成命令: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
DIETAI_FIELD_ENCRYPTION_KEY=YOUR_FIELD_ENCRYPTION_KEY

# CORS - 替换为你的域名
DIETAI_CORS_ORIGINS=https://YOUR_DOMAIN.com

# Allowed Hosts - 替换为你的域名
DIETAI_ALLOWED_HOSTS=YOUR_DOMAIN.com
